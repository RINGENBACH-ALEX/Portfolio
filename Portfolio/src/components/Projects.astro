---
import Waves from "./Waves.astro";
import ProjetCard from "./ProjetCard.astro";
import Carousel from "./Carousel.astro";
import { allProjets } from "../backend.mjs";

let projets: any[] = [];
try {
	projets = (await allProjets()).slice(0, 5);
} catch (e) {
	console.error(
		"Carrousel projets — PocketBase indisponible :",
		(e as Error).message,
	);
}
---

<section
	id="projets"
	class="relative overflow-hidden bg-linear-to-br from-crimson via-[#5c0420] to-ink py-24 text-white"
>
	<Waves tone="light" intensity={0.9} seed={5} />
	<div class="grid-page relative z-1">
		<div class="col-full">
			<p class="text-xs font-bold uppercase tracking-[.3em] text-white">
				03 · Réalisations
			</p>
			<h2 class="mt-5 font-display text-4xl sm:text-5xl">
				Du concept à l'expérience.
			</h2>

			<Carousel
				label="Projets"
				moreHref="/projets"
				moreLabel="Voir tous les projets"
				tone="light"
			>
				{
					projets.map((p) => (
						<li class="h-96 w-full shrink-0 snap-start sm:h-104 lg:h-120">
							<ProjetCard
								projet={p}
								variant="split"
								size="lg"
								class="h-full"
							/>
						</li>
					))
				}
			</Carousel>
		</div>
	</div>
</section>
