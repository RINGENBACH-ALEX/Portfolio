---
import Waves from "./Waves.astro";
import ProjetCard from "./ProjetCard.astro";
import { allProjets } from "../backend.mjs";

let projets: any[] = [];
try {
	projets = (await allProjets()).slice(0, 5);
} catch (e) {
	console.error(
		"Carrousel projets — PocketBase indisponible :",
		(e as Error).message,
	);
}
---

<section
	id="projets"
	class="relative overflow-hidden bg-linear-to-br from-crimson via-[#5c0420] to-ink px-6 py-24 text-white lg:px-[max(8vw,2rem)]"
>
	<Waves tone="light" intensity={0.9} seed={5} />
	<div class="relative z-1 mx-auto max-w-6xl">
		<p class="text-xs font-bold uppercase tracking-[.3em] text-white/70">
			03 · Réalisations
		</p>
		<h2 class="mt-5 font-display text-4xl sm:text-5xl">
			Du concept à l'expérience.
		</h2>

		<div class="carousel mt-12" data-carousel>
			<ul
				class="no-scrollbar flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-2"
				data-track
			>
				{
					projets.map((p) => (
						<li class="w-72 shrink-0 snap-start sm:w-96">
							<ProjetCard projet={p} class="h-full" />
						</li>
					))
				}
			</ul>

			<div class="mt-8 flex items-center gap-3">
				<button
					type="button"
					data-prev
					aria-label="Projet précédent"
					class="grid h-11 w-11 place-items-center rounded-full border border-white/30 transition hover:border-white hover:text-white"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
				</button>
				<button
					type="button"
					data-next
					aria-label="Projet suivant"
					class="grid h-11 w-11 place-items-center rounded-full border border-white/30 transition hover:border-white hover:text-white"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
				</button>

				<a
					href="/projets"
					data-more
					class="ml-1 hidden items-center gap-2 rounded-full bg-white px-5 py-3 text-xs font-bold uppercase tracking-[.18em] text-crimson transition hover:bg-ink hover:text-white"
				>
					Voir tous les projets
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	import "../scripts/carousel.js";
</script>
