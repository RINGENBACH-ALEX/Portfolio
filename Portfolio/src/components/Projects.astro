---
import Waves from "./Waves.astro";

const projects = [
	[
		"Identité visuelle",
		"Festival",
		"Logo, système typographique, palette, affiches et déclinaisons print & réseaux pour donner une identité forte à un festival.",
	],
	[
		"Design d'interface",
		"Site vitrine",
		"Direction artistique, maquettes et prototype Figma : une interface cohérente, accessible et responsive.",
	],
];
---

<section
	id="projets"
	class="relative overflow-hidden bg-linear-to-br from-crimson via-[#5c0420] to-ink px-6 py-24 text-white lg:px-[max(8vw,2rem)]"
>
	<Waves tone="light" intensity={0.9} seed={5} />
	<div class="relative z-1 max-w-6xl">
		<p class="text-xs font-bold uppercase tracking-[.3em] text-white/70">
			03 · Réalisations
		</p>
		<h2 class="mt-5 font-display text-4xl sm:text-5xl">
			Du concept à l'expérience.
		</h2>
		<div class="mt-12 grid gap-5 lg:grid-cols-2">
			{
				projects.map(([type, title, text], i) => (
					<article class="rounded-[2rem] border border-white/15 bg-ink/60 p-6 backdrop-blur-sm sm:p-8">
						<p class="text-xs font-bold uppercase tracking-[.2em] text-crimson">
							{String(i + 1).padStart(2, "0")} · {type}
						</p>
						<div class="my-14 h-42 rounded-3xl border border-white/25 bg-[repeating-linear-gradient(135deg,#c50337_0_2px,transparent_2px_13px)]" />
						<h3 class="font-display text-3xl">{title}</h3>
						<p class="mt-4 max-w-md leading-relaxed text-white/70">
							{text}
						</p>
					</article>
				))
			}
		</div>
	</div>
</section>
