---
import logo from "../assets/logo.webp";
import Icon from "./Icon.astro";

const links = [
	{ href: "/projets", label: "Projets" },
	{ href: "/profil", label: "Profil" },
	{ href: "/competences", label: "Compétences" },
	{ href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
	href === "/" ? path === "/" : path.startsWith(href);
---

<header class="absolute inset-x-0 top-0 z-30 grid-page py-6">
	{/* Le bord extérieur de la pilule tombe sur les lignes de la grille
	    (mêmes bords que les cartes du reste du site). */}
	<div
		class="col-full flex items-center justify-between rounded-full border border-white/15 bg-ink/90 px-5 py-3 shadow-xl backdrop-blur"
	>
		<a
			href="/"
			class="flex items-center gap-3"
			aria-label="Alex Ringenbach — accueil"
		>
			<img
				src={logo.src}
				alt=""
				width="40"
				height="40"
				class="h-10 w-10"
			/>
			<span class="hidden text-xs tracking-[.25em] sm:block">
				ALEX RINGENBACH
			</span>
		</a>

		<nav
			aria-label="Navigation principale"
			class="hidden gap-7 text-[10px] font-bold uppercase tracking-[.18em] md:flex"
		>
			{
				links.map((l) => (
					<a
						href={l.href}
						aria-current={isCurrent(l.href) ? "page" : undefined}
						class="transition hover:text-crimson aria-[current=page]:text-crimson"
					>
						{l.label}
					</a>
				))
			}
		</nav>

		<button
			type="button"
			data-menu-btn
			aria-label="Ouvrir le menu"
			aria-expanded="false"
			aria-controls="menu-mobile"
			class="grid h-10 w-10 place-items-center rounded-full border border-white/15 transition hover:border-crimson hover:text-crimson md:hidden"
		>
			<Icon name="menu" size={18} data-menu-open />
			<Icon name="close" size={18} class="hidden" data-menu-close />
		</button>
	</div>

	<nav
		id="menu-mobile"
		data-menu
		aria-label="Navigation principale"
		class="col-full mt-2 hidden overflow-hidden rounded-[1.75rem] border border-white/15 bg-ink/95 p-3 shadow-xl backdrop-blur md:hidden"
	>
		<ul
			role="list"
			class="flex flex-col text-xs font-bold uppercase tracking-[.18em]"
		>
			{
				links.map((l) => (
					<li>
						<a
							href={l.href}
							aria-current={isCurrent(l.href) ? "page" : undefined}
							class="block rounded-2xl px-4 py-3.5 transition hover:bg-white/5 hover:text-crimson aria-[current=page]:text-crimson"
						>
							{l.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
	const panel = document.querySelector<HTMLElement>("[data-menu]");
	const iconOpen = document.querySelector<SVGElement>("[data-menu-open]");
	const iconClose = document.querySelector<SVGElement>("[data-menu-close]");

	function setOpen(open: boolean) {
		if (!btn || !panel) return;
		panel.classList.toggle("hidden", !open);
		iconOpen?.classList.toggle("hidden", open);
		iconClose?.classList.toggle("hidden", !open);
		btn.setAttribute("aria-expanded", String(open));
	}

	btn?.addEventListener("click", () =>
		setOpen(panel?.classList.contains("hidden") ?? false),
	);
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && !panel?.classList.contains("hidden")) {
			setOpen(false);
			btn?.focus();
		}
	});
	document.addEventListener("click", (e) => {
		if (
			panel &&
			!panel.classList.contains("hidden") &&
			!panel.contains(e.target as Node) &&
			!btn?.contains(e.target as Node)
		)
			setOpen(false);
	});
</script>
