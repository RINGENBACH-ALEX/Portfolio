---
import { Image } from "astro:assets";
import portrait from "../assets/img/portrait.jpg";
import Waves from "./Waves.astro";
import Icon from "./Icon.astro";
---

<section class="relative min-h-screen overflow-hidden bg-ink pt-28">
	<div
		class="pointer-events-none absolute -right-40 -top-40 h-[40rem] w-[40rem] rounded-full bg-crimson opacity-30 blur-[130px]"
	>
	</div>
	<Waves tone="accent" intensity={0.6} seed={1} />

	<div class="grid-page relative z-1 min-h-screen items-center">
		<div class="col-full flex flex-col justify-center py-20 md:col-span-5 lg:col-span-6">
			<p
				class="mb-6 text-xs font-bold uppercase tracking-[.35em] text-white"
			>
				BUT MMI · Design graphique & direction artistique
			</p>
			<h1 class="font-display text-5xl leading-[.95] sm:text-7xl md:text-6xl lg:text-7xl xl:text-8xl">
				Alex<br />Ringenbach
			</h1>
			<p class="mt-8 max-w-lg text-lg leading-relaxed text-white">
				Je conçois des identités visuelles, des supports print et des
				interfaces soignés, pensés pour leurs publics.
			</p>
			<div class="mt-10 flex flex-wrap gap-3">
				<a
					href="/projets/"
					class="rounded-full bg-crimson px-6 py-3 text-xs font-bold uppercase tracking-[.18em] text-white transition hover:bg-white hover:text-crimson"
					>Découvrir mes projets</a
				>
				{/* CV : fichier public/cv.pdf, téléchargé directement */}
				<a
					href="/cv.pdf"
					download="CV-Alex-Ringenbach.pdf"
					class="inline-flex items-center gap-2 rounded-full border border-white px-6 py-3 text-xs font-bold uppercase tracking-[.18em] text-white transition hover:bg-white hover:text-ink"
				>
					Télécharger mon CV
					<Icon name="download" size={14} />
					<span class="sr-only">(PDF)</span>
				</a>
			</div>
		</div>

		<div class="col-full py-8 md:col-span-3 md:col-start-6 md:py-0 lg:col-span-4 lg:col-start-9">
			<div class="relative w-full max-w-xs sm:max-w-sm md:max-w-none">
				<div class="absolute -bottom-4 -left-4 h-full w-full bg-crimson"></div>
				<Image
					src={portrait}
					alt="Portrait d'Alex Ringenbach"
					width={480}
					widths={[320, 480, 640, 960]}
					sizes="(min-width: 64rem) 30vw, (min-width: 48rem) 35vw, (min-width: 40rem) 24rem, 20rem"
					format="webp"
					quality={58}
					loading="eager"
					fetchpriority="high"
					class="relative aspect-4/5 w-full object-cover object-top grayscale contrast-125 lg:aspect-3/4"
				/>
			</div>
		</div>
	</div>
</section>
