---
import Waves from "./Waves.astro";
import logo from "../assets/Logo_Portfolio.svg";

const annee = new Date().getFullYear();

const nav = [
	{ label: "Accueil", href: "/" },
	{ label: "Projets", href: "/#projets" },
	{ label: "Profil", href: "/profil" },
	{ label: "Compétences", href: "/competences" },
	{ label: "Contact", href: "/contact" },
];

const reseaux = [
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/alex-ringenbach/" },
	{ label: "GitHub", href: "https://github.com/RINGENBACH-ALEX" },
	{ label: "Instagram", href: "https://www.instagram.com/alex_tremitee/" },
];
---

<footer id="contact" class="px-6 py-20 lg:px-[max(8vw,2rem)]">
	<div
		class="relative mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] border border-white/10 bg-[#0c0c12] p-8 sm:p-12"
	>
		<Waves tone="accent" intensity={0.7} seed={8} />

		<div
			class="relative z-1 grid gap-12 lg:grid-cols-[1.5fr_1fr_1fr]"
		>
			<div>
				<div class="flex items-center gap-3">
					<img src={logo.src} alt="Monogramme AR" class="h-10 w-10" />
					<span class="text-xs tracking-[.25em]">ALEX RINGENBACH</span>
				</div>
				<p class="mt-7 font-display text-3xl text-crimson">Parlons-en.</p>
				<p class="mt-3 max-w-xs text-sm leading-relaxed text-white/60">
					Étudiant en BUT MMI, spécialisé en design graphique.
					Disponible pour un stage ou une alternance.
				</p>
				<a
					class="mt-6 inline-block rounded-full border border-crimson/50 px-5 py-3 text-sm text-white/80 transition hover:border-crimson hover:bg-crimson hover:text-white"
					href="mailto:alex.ringenbach0@gmail.com"
					>alex.ringenbach0@gmail.com</a
				>
			</div>

			<nav>
				<p
					class="text-[11px] font-bold uppercase tracking-[.25em] text-white/40"
				>
					Navigation
				</p>
				<ul class="mt-5 space-y-3 text-sm">
					{
						nav.map((item) => (
							<li>
								<a
									href={item.href}
									class="transition hover:text-crimson"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div>
				<p
					class="text-[11px] font-bold uppercase tracking-[.25em] text-white/40"
				>
					Réseaux
				</p>
				<ul class="mt-5 space-y-3 text-sm">
					{
						reseaux.map((r) => (
							<li>
								<a
									href={r.href}
									target="_blank"
									rel="noreferrer"
									class="group inline-flex items-center gap-1.5 transition hover:text-crimson"
								>
									{r.label}
									<svg
										width="12"
										height="12"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2.5"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="opacity-40 transition group-hover:opacity-100"
									>
										<path d="M7 17 17 7M8 7h9v9" />
									</svg>
								</a>
							</li>
						))
					}
				</ul>

				<p
					class="mt-8 text-[11px] font-bold uppercase tracking-[.25em] text-white/40"
				>
					Basé à
				</p>
				<p class="mt-2 text-sm text-white/60">Delle, France</p>
			</div>
		</div>

		<div
			class="relative z-1 mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-[10px] uppercase tracking-[.2em] text-white/40 sm:flex-row sm:items-center sm:justify-between"
		>
			<p>© {annee} Alex Ringenbach</p>
			<p>Conçu & développé par Alex Ringenbach</p>
		</div>
	</div>
</footer>
