---
import Waves from "./Waves.astro";
import Icon from "./Icon.astro";
import logo from "../assets/logo.webp";

const annee = new Date().getFullYear();

const nav = [
	{ label: "Accueil", href: "/" },
	{ label: "Projets", href: "/projets" },
	{ label: "Profil", href: "/profil" },
	{ label: "Compétences", href: "/competences" },
	{ label: "Contact", href: "/contact" },
];

const reseaux = [
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/alex-ringenbach/" },
	{ label: "GitHub", href: "https://github.com/RINGENBACH-ALEX" },
	{ label: "Instagram", href: "https://www.instagram.com/alex_tremitee/" },
];
---

<footer id="contact" class="px-6 py-20 lg:px-[max(8vw,2rem)]">
	<div
		class="relative mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] border border-white/10 bg-[#0c0c12] p-8 sm:p-12"
	>
		<Waves tone="accent" intensity={0.7} seed={8} />

		<div class="relative z-1 grid gap-12 lg:grid-cols-[1.5fr_1fr_1fr]">
			<div>
				<div class="flex items-center gap-3">
					<img
						src={logo.src}
						alt=""
						width="40"
						height="40"
						class="h-10 w-10"
					/>
					<span class="text-xs tracking-[.25em]">ALEX RINGENBACH</span>
				</div>
				<p class="mt-7 font-display text-3xl text-crimson">Parlons-en.</p>
				<p class="mt-3 max-w-xs text-sm leading-relaxed text-white/70">
					Étudiant en BUT MMI, spécialisé en design graphique.
					Disponible pour un stage ou une alternance.
				</p>
				<a
					class="mt-6 inline-block rounded-full border border-crimson/50 px-5 py-3 text-sm text-white/90 transition hover:border-crimson hover:bg-crimson hover:text-white"
					href="mailto:alex.ringenbach0@gmail.com"
					>alex.ringenbach0@gmail.com</a
				>
			</div>

			<nav aria-label="Pied de page">
				<h2
					class="text-[11px] font-bold uppercase tracking-[.25em] text-white/55"
				>
					Navigation
				</h2>
				<ul role="list" class="mt-5 space-y-3 text-sm">
					{
						nav.map((item) => (
							<li>
								<a
									href={item.href}
									class="text-white/85 transition hover:text-crimson"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div>
				<h2
					class="text-[11px] font-bold uppercase tracking-[.25em] text-white/55"
				>
					Réseaux
				</h2>
				<ul role="list" class="mt-5 space-y-3 text-sm">
					{
						reseaux.map((r) => (
							<li>
								<a
									href={r.href}
									target="_blank"
									rel="noreferrer"
									class="group inline-flex items-center gap-1.5 text-white/85 transition hover:text-crimson"
								>
									{r.label}
									<Icon
										name="external"
										size={12}
										class="opacity-50 transition group-hover:opacity-100"
									/>
									<span class="sr-only">(nouvel onglet)</span>
								</a>
							</li>
						))
					}
				</ul>

				<h2
					class="mt-8 text-[11px] font-bold uppercase tracking-[.25em] text-white/55"
				>
					Basé à
				</h2>
				<p class="mt-2 text-sm text-white/70">Montbéliard, France</p>
			</div>
		</div>

		<div
			class="relative z-1 mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-[10px] uppercase tracking-[.2em] text-white/55 sm:flex-row sm:items-center sm:justify-between"
		>
			<p>© {annee} Alex Ringenbach</p>
			<div class="flex flex-wrap gap-x-5 gap-y-2">
				<a href="/mentions-legales" class="transition hover:text-crimson"
					>Mentions légales</a
				>
				<span>Conçu &amp; développé par Alex Ringenbach</span>
			</div>
		</div>
	</div>
</footer>
