---
import Waves from "./Waves.astro";

interface Props {
	eyebrow: string;
	title: string;
	/** colonne de lecture étroite (.col-prose) au lieu de toute la largeur */
	narrow?: boolean;
	seed?: number;
}

const { eyebrow, title, narrow = false, seed = 0 } = Astro.props;
---

<section class="relative overflow-hidden pb-16 pt-40">
	<div
		class="pointer-events-none absolute -right-40 -top-24 h-[38rem] w-[38rem] rounded-full bg-crimson opacity-25 blur-[130px]"
	>
	</div>
	<Waves tone="accent" intensity={0.6} seed={seed} />

	<div class="grid-page relative z-1">
		<div class:list={[narrow ? "col-prose" : "col-full lg:col-span-9"]}>
			<p class="text-xs font-bold uppercase tracking-[.3em] text-white">
				{eyebrow}
			</p>
			<h1 class="mt-5 font-display text-5xl leading-[.95] sm:text-6xl">
				{title}
			</h1>
			<slot />
		</div>
	</div>
</section>
