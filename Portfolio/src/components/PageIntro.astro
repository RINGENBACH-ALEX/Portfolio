---
import Waves from "./Waves.astro";

interface Props {
	eyebrow: string;
	title: string;
	/** largeur du contenu : max-w-3xl si true, sinon max-w-6xl */
	narrow?: boolean;
	seed?: number;
}

const { eyebrow, title, narrow = false, seed = 0 } = Astro.props;
---

<section
	class="relative overflow-hidden px-6 pb-16 pt-40 lg:px-[max(8vw,2rem)]"
>
	<div
		class="pointer-events-none absolute -right-40 -top-24 h-[38rem] w-[38rem] rounded-full bg-crimson opacity-25 blur-[130px]"
	>
	</div>
	<Waves tone="accent" intensity={0.6} seed={seed} />

	<div class:list={["relative z-1 mx-auto", narrow ? "max-w-3xl" : "max-w-6xl"]}>
		<p class="text-xs font-bold uppercase tracking-[.3em] text-crimson">
			{eyebrow}
		</p>
		<h1 class="mt-5 font-display text-5xl leading-[.95] sm:text-6xl">
			{title}
		</h1>
		<slot />
	</div>
</section>
