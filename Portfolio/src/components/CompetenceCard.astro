---
import { Image } from "astro:assets";
import { getImageUrl } from "../backend.mjs";

const NIVEAUX = { Faible: 1, Moyenne: 2, Haute: 3, Experte: 4 };

interface Props {
	competence: {
		nom?: string;
		maitrise?: string;
		Logo?: string;
		[key: string]: unknown;
	};
	class?: string;
}

const { competence: c, class: className = "" } = Astro.props;
const lvl = NIVEAUX[c.maitrise as keyof typeof NIVEAUX] ?? 0;
const logo = getImageUrl(c, "Logo");
---

<div
	class:list={[
		"group overflow-hidden rounded-3xl border border-ink/15 bg-ink/3 transition duration-500 hover:-translate-y-1 hover:border-crimson hover:shadow-[0_26px_50px_-30px_rgba(197,3,55,.55)] motion-reduce:transition-none motion-reduce:hover:translate-y-0",
		className,
	]}
>
	{
		logo && (
			<div class="overflow-hidden">
				<Image
					src={logo}
					alt={c.nom ?? ""}
					width={640}
					height={360}
					format="webp"
					quality={72}
					class="aspect-video w-full bg-white object-cover transition duration-500 group-hover:scale-[1.06] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
					loading="lazy"
				/>
			</div>
		)
	}
	<div class="p-5">
		<p class="font-display text-xl">{c.nom}</p>
		<span class="mt-3 flex gap-1" data-lvl>
			{
				[0, 1, 2, 3].map((i) => (
					<span
						class:list={[
							"lvl-bar h-1.5 w-5 rounded-full",
							i < lvl ? "bg-crimson" : "bg-ink/15",
						]}
					/>
				))
			}
		</span>
		<p
			class="mt-2 text-[11px] font-bold uppercase tracking-[.15em] text-ink/65"
		>
			{c.maitrise ?? "—"}
		</p>
	</div>
</div>

<style>
	/* Les jauges se remplissent UNE fois, quand la carte entre dans l'écran.
	   Avant : une animation liée au scroll (animation-timeline: view()) par
	   jauge, soit ~76 timelines recalculées à chaque image -> 7,7 s de travail
	   du thread principal mesurées par Lighthouse sur /maitrises/.
	   Ici : une simple transition déclenchée par IntersectionObserver.
	   Sans JS (classe .js-lvl jamais posée) -> jauges pleines directement. */
	@media (prefers-reduced-motion: no-preference) {
		.js-lvl .lvl-bar {
			transform: scaleX(0);
			transform-origin: left;
			opacity: 0;
			transition:
				transform 0.5s ease-out,
				opacity 0.5s ease-out;
		}
		.js-lvl .lvl-bar:nth-child(2) {
			transition-delay: 0.08s;
		}
		.js-lvl .lvl-bar:nth-child(3) {
			transition-delay: 0.16s;
		}
		.js-lvl .lvl-bar:nth-child(4) {
			transition-delay: 0.24s;
		}
		.js-lvl.is-visible .lvl-bar {
			transform: none;
			opacity: 1;
		}
	}
</style>

<script>
	const jauges = document.querySelectorAll<HTMLElement>("[data-lvl]");
	if ("IntersectionObserver" in window) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					e.target.classList.add("is-visible");
					io.unobserve(e.target); // une seule fois, puis plus aucun coût
				}
			},
			{ rootMargin: "0px 0px -10% 0px" },
		);
		for (const j of jauges) {
			j.classList.add("js-lvl");
			io.observe(j);
		}
	}
</script>
