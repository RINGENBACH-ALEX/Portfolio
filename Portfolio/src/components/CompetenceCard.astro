---
import { getImageUrl } from "../backend.mjs";

const NIVEAUX = { Faible: 1, Moyenne: 2, Haute: 3, Experte: 4 };

interface Props {
	competence: {
		nom?: string;
		maitrise?: string;
		Logo?: string;
		[key: string]: unknown;
	};
	class?: string;
}

const { competence: c, class: className = "" } = Astro.props;
const lvl = NIVEAUX[c.maitrise as keyof typeof NIVEAUX] ?? 0;
---

<div
	class:list={[
		"overflow-hidden rounded-3xl border border-ink/15 bg-ink/3",
		className,
	]}
>
	<img
		src={getImageUrl(c, "Logo")}
		alt={c.nom}
		class="aspect-video w-full bg-white object-cover"
		loading="lazy"
		decoding="async"
	/>
	<div class="p-5">
		<p class="font-display text-xl">{c.nom}</p>
		<span class="mt-3 flex gap-1">
			{
				[0, 1, 2, 3].map((i) => (
					<span
						class:list={[
							"h-1.5 w-5 rounded-full",
							i < lvl ? "bg-crimson" : "bg-ink/15",
						]}
					/>
				))
			}
		</span>
		<p
			class="mt-2 text-[11px] font-bold uppercase tracking-[.15em] text-ink/50"
		>
			{c.maitrise ?? "—"}
		</p>
	</div>
</div>
