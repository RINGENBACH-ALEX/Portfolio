---
import { Image } from "astro:assets";
import { getImageUrl } from "../backend.mjs";
import { hostname } from "../lib/url.js";
import Icon from "./Icon.astro";

interface Props {
	projet: {
		id?: string;
		titre?: string;
		description?: string;
		lien?: string;
		image?: string | string[];
		type?: string;
		[key: string]: unknown;
	};
	class?: string;
}

const TYPES: Record<string, string> = {
	"site-web": "Site web",
	maquette: "Maquette",
};

const { projet: p, class: className = "" } = Astro.props;
const img = getImageUrl(p, "image");
const typeLabel = p.type ? (TYPES[p.type] ?? p.type) : "";
const href = p.id ? `/projet/${p.id}` : undefined;
const host = hostname(p.lien);
---

<article
	class:list={[
		"group flex flex-col overflow-hidden rounded-[2rem] border border-white/15 bg-ink/60 backdrop-blur-sm transition hover:border-crimson",
		className,
	]}
>
	<a href={href} class="block" aria-label={p.titre}>
		{
			img ? (
				<Image
					src={img}
					alt={p.titre ?? ""}
					width={760}
					height={428}
					format="webp"
					quality={68}
					class="aspect-video w-full object-cover"
					loading="lazy"
				/>
			) : (
				<div class="aspect-video w-full border-b border-white/15 bg-[repeating-linear-gradient(135deg,#c50337_0_2px,transparent_2px_13px)]" />
			)
		}
	</a>

	<div class="flex flex-1 flex-col p-6 sm:p-8">
		{
			typeLabel && (
				<p class="text-[11px] font-bold uppercase tracking-[.2em] text-crimson">
					{typeLabel}
				</p>
			)
		}
		<h3 class="mt-2 font-display text-2xl sm:text-3xl">
			<a href={href} class="transition group-hover:text-crimson">
				{p.titre}
			</a>
		</h3>
		<p class="mt-3 line-clamp-3 leading-relaxed text-white/70">
			{p.description}
		</p>

		<div class="mt-6 flex flex-wrap items-center gap-4">
			<a
				href={href}
				class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[.18em] text-white transition hover:text-crimson"
			>
				Détails
				<Icon name="arrow-right" size={14} />
			</a>

			{
				p.lien && (
					<a
						href={p.lien}
						target="_blank"
						rel="noreferrer"
						class="inline-flex min-w-0 items-center gap-1.5 text-xs font-bold uppercase tracking-[.18em] text-crimson transition hover:text-white"
					>
						<span class="truncate">{host || "Voir en ligne"}</span>
						<Icon name="external" size={13} class="shrink-0" />
					</a>
				)
			}
		</div>
	</div>
</article>
