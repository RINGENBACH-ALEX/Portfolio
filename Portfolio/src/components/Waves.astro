---
interface Props {
	/** couleur des vagues : "light" = blanc, "accent" = rouge */
	tone?: "light" | "accent";
	/** densité / opacité globale */
	intensity?: number;
	/** décale le motif pour varier d'une section à l'autre */
	seed?: number;
}

const { tone = "light", intensity = 1, seed = 0 } = Astro.props;

const W = 1440;
const H = 600;

// Principe du CodePen : chaque ligne est une sinusoïde qu'on décale d'exactement
// UNE longueur d'onde, en boucle. Le tracé n'a donc besoin de couvrir que
// W + une longueur d'onde (au lieu de 2×W), et chaque ligne a sa propre vitesse.
const lines = Array.from({ length: 7 }, (_, i) => {
	const y = Math.round(70 + (i / 6) * (H - 140));
	const amp = Math.round(24 + Math.sin(i * 1.7 + seed) * 12);
	const wl = [360, 288, 240][i % 3];
	const half = wl / 2;
	const dir = Math.sin(i * 2.3 + seed) > 0 ? -1 : 1;

	let d = `M0 ${y}q${wl / 4} ${dir * 2 * amp} ${half} 0`;
	for (let x = half; x < W + wl; x += half) d += `t${half} 0`;

	// vitesse propre à chaque ligne (18 à 38 px/s) -> léger effet de parallaxe
	const speed = 28 + 10 * Math.sin(i * 1.3 + seed);

	return {
		d,
		w: 2 + (i % 4) * 1.6,
		o: ((0.19 + 0.06 * Math.sin(i * 2.1 + seed)) * intensity).toFixed(3),
		shift: -wl,
		dur: (wl / speed).toFixed(1),
	};
});
---

<div
	class="waves"
	aria-hidden="true"
	style={`--wave-color:${tone === "accent" ? "#c50337" : "#fff"}`}
>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox={`0 0 ${W} ${H}`}
		preserveAspectRatio="xMidYMid slice"
	>
		<g fill="none" stroke="currentColor" stroke-linecap="round">
			{
				lines.map((l) => (
					<path
						class="waves__line"
						d={l.d}
						stroke-width={l.w}
						style={`opacity:${l.o};--shift:${l.shift}px;--dur:${l.dur}s`}
					/>
				))
			}
		</g>
	</svg>
</div>

<style>
	.waves {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
		color: var(--wave-color);
	}
	.waves svg {
		display: block;
		width: 100%;
		height: 100%;
	}
	@media (prefers-reduced-motion: no-preference) {
		.waves__line {
			animation: waves-scroll var(--dur) linear infinite;
		}
	}
	/* décalage d'une longueur d'onde exactement : la boucle est sans couture */
	@keyframes waves-scroll {
		to {
			transform: translateX(var(--shift));
		}
	}
</style>
