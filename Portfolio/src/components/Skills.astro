---
import { allCompetences } from "../backend.mjs";
import CompetenceCard from "./CompetenceCard.astro";

let competences: any[] = [];
try {
	competences = (await allCompetences()).slice(0, 5);
} catch (e) {
	console.error(
		"Carrousel compétences — PocketBase indisponible :",
		(e as Error).message,
	);
}
---

<section
	id="competences"
	class="bg-white px-6 py-24 text-ink lg:px-[max(8vw,2rem)]"
>
	<div class="mx-auto max-w-6xl">
		<p class="text-xs font-bold uppercase tracking-[.3em] text-crimson">
			02 · Compétences
		</p>
		<h2 class="mt-5 max-w-xl font-display text-4xl sm:text-5xl">
			Les outils que je manie.
		</h2>

		<div
			class="carousel mt-12"
			data-carousel
			data-count={competences.length}
		>
			<ul
				class="no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2"
				data-track
			>
				{
					competences.map((c) => (
						<li class="w-56 shrink-0 snap-start sm:w-64">
							<CompetenceCard competence={c} />
						</li>
					))
				}
			</ul>

			<div class="mt-8 flex items-center gap-3">
				<button
					type="button"
					data-prev
					aria-label="Compétence précédente"
					class="grid h-11 w-11 place-items-center rounded-full border border-ink/20 transition hover:border-crimson hover:text-crimson"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
				</button>
				<button
					type="button"
					data-next
					aria-label="Compétence suivante"
					class="grid h-11 w-11 place-items-center rounded-full border border-ink/20 transition hover:border-crimson hover:text-crimson"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
				</button>

				<a
					href="/competences"
					data-more
					class="ml-1 hidden items-center gap-2 rounded-full bg-crimson px-5 py-3 text-xs font-bold uppercase tracking-[.18em] text-white transition hover:bg-ink"
				>
					Voir plus de compétences
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.no-scrollbar {
		scrollbar-width: none;
	}
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
</style>

<script>
	function initCarousel(root: HTMLElement) {
		const track = root.querySelector<HTMLElement>("[data-track]");
		const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
		const next = root.querySelector<HTMLButtonElement>("[data-next]");
		const more = root.querySelector<HTMLElement>("[data-more]");
		if (!track || !prev || !next || !more) return;

		const step = () => {
			const card = track.querySelector<HTMLElement>("li");
			if (!card) return track.clientWidth;
			const gap = parseFloat(getComputedStyle(track).columnGap || "16") || 16;
			return card.offsetWidth + gap;
		};

		function update() {
			const atStart = track.scrollLeft <= 2;
			const atEnd =
				track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;

			prev.classList.toggle("invisible", atStart);
			next.classList.toggle("invisible", atEnd);
			more.classList.toggle("hidden", !atEnd);
			more.classList.toggle("inline-flex", atEnd);
		}

		prev.addEventListener("click", () =>
			track.scrollBy({ left: -step(), behavior: "smooth" }),
		);
		next.addEventListener("click", () =>
			track.scrollBy({ left: step(), behavior: "smooth" }),
		);
		track.addEventListener("scroll", update, { passive: true });
		window.addEventListener("resize", update);
		update();
	}

	document
		.querySelectorAll<HTMLElement>("[data-carousel]")
		.forEach(initCarousel);
</script>
