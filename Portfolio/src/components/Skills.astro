---
import { allCompetences } from "../backend.mjs";
import CompetenceCard from "./CompetenceCard.astro";
import Carousel from "./Carousel.astro";

let competences: any[] = [];
try {
	competences = (await allCompetences()).slice(0, 5);
} catch (e) {
	console.error(
		"Carrousel compétences — PocketBase indisponible :",
		(e as Error).message,
	);
}
---

<section id="competences" class="bg-white py-24 text-ink">
	<div class="grid-page">
		<div class="col-full">
			<p class="text-xs font-bold uppercase tracking-[.3em] text-crimson">
				02 · Compétences
			</p>
			<h2 class="mt-5 max-w-xl font-display text-4xl sm:text-5xl">
				Les outils que je manie.
			</h2>

			<Carousel
				label="Compétences"
				moreHref="/competences/"
				moreLabel="Voir plus de compétences"
				tone="dark"
			>
				{
					competences.map((c) => (
						<li class="w-56 shrink-0 snap-start sm:w-64">
							<CompetenceCard competence={c} />
						</li>
					))
				}
			</Carousel>
		</div>
	</div>
</section>
