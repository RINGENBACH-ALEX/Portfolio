---
import Layout from "../layouts/Layout.astro";
import Waves from "../components/Waves.astro";
import ContactForm from "../components/ContactForm.astro";
import { breadcrumbNode } from "../lib/seo.js";

const jsonLd = [
	{
		"@type": "ContactPage",
		name: "Contact — Alex Ringenbach",
		mainEntity: { "@id": "https://alex-ringenbach.fr/#person" },
	},
	breadcrumbNode([
		{ name: "Accueil", path: "/" },
		{ name: "Contact", path: "/contact/" },
	]),
];
---

<Layout
	title="Contact — Alex Ringenbach"
	description="Contacter Alex Ringenbach, designer graphique, pour un projet, un stage ou une alternance."
	jsonLd={jsonLd}
>
	<section class="relative min-h-screen overflow-hidden pb-24 pt-40">
		<div
			class="pointer-events-none absolute -right-40 -top-20 h-144 w-xl rounded-full bg-crimson opacity-25 blur-[130px]"
		>
		</div>
		<Waves tone="accent" intensity={0.7} seed={2} />

		<div class="grid-page relative z-1 gap-y-12">
			<div class="col-full lg:col-span-5">
				<p
					class="text-xs font-bold uppercase tracking-[.3em] text-white"
				>
					Contact
				</p>
				<h1 class="mt-5 font-display text-5xl">
					Parlons de votre projet.
				</h1>
				<p class="mt-6 text-lg text-white">
					Une question, une opportunité ou une collaboration ?
					Écrivez-moi, je réponds sous 48h.
				</p>
				<a
					class="mt-8 inline-block text-sm text-white underline decoration-crimson underline-offset-4 transition hover:text-white"
					href="mailto:alex.ringenbach0@gmail.com"
					>alex.ringenbach0@gmail.com</a
				>
			</div>

			<ContactForm class="col-full lg:col-span-6 lg:col-start-7" />
		</div>
	</section>
</Layout>

