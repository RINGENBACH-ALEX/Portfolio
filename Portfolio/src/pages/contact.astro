---
import Layout from "../layouts/Layout.astro";
import Waves from "../components/Waves.astro";
import Field from "../components/Field.astro";
import { breadcrumbNode } from "../lib/seo.js";

const jsonLd = [
	{
		"@type": "ContactPage",
		name: "Contact — Alex Ringenbach",
		mainEntity: { "@id": "https://alex-ringenbach.fr/#person" },
	},
	breadcrumbNode([
		{ name: "Accueil", path: "/" },
		{ name: "Contact", path: "/contact" },
	]),
];

// Endpoint FormSubmit (aucun backend requis, offre gratuite).
// Au 1er envoi tu recevras un mail d'activation à valider une seule fois.
// Pour masquer l'adresse : crée une clé sur https://formsubmit.co et
// remplace l'email par la clé (ex. "a1b2c3d4-....").
const FORM_ENDPOINT = "https://formsubmit.co/ajax/alex.ringenbach0@gmail.com";
---

<Layout
	title="Contact — Alex Ringenbach"
	description="Contacter Alex Ringenbach, designer graphique, pour un projet, un stage ou une alternance."
	jsonLd={jsonLd}
>
	<section
		class="relative min-h-screen overflow-hidden pb-24 pt-40"
	>
		<div
			class="pointer-events-none absolute -right-40 -top-20 h-[36rem] w-[36rem] rounded-full bg-crimson opacity-25 blur-[130px]"
		>
		</div>
		<Waves tone="accent" intensity={0.7} seed={2} />

		<div class="grid-page relative z-1 gap-y-12">
			<div class="col-full lg:col-span-5">
				<p class="text-xs font-bold uppercase tracking-[.3em] text-crimson">
					Contact
				</p>
				<h1 class="mt-5 font-display text-5xl">Parlons de votre projet.</h1>
				<p class="mt-6 text-lg text-white/70">
					Une question, une opportunité ou une collaboration ?
					Écrivez-moi, je réponds sous 48&nbsp;h.
				</p>
				<a
					class="mt-8 inline-block text-sm text-white/60 underline decoration-crimson underline-offset-4 transition hover:text-white"
					href="mailto:alex.ringenbach0@gmail.com"
					>alex.ringenbach0@gmail.com</a
				>
			</div>

			<form
				id="contact-form"
				method="POST"
				action={FORM_ENDPOINT.replace("/ajax/", "/")}
				data-endpoint={FORM_ENDPOINT}
				aria-label="Formulaire de contact"
				class="col-full rounded-[2rem] border border-white/10 bg-[#0c0c12] p-6 sm:p-8 lg:col-span-6 lg:col-start-7"
			>
				<div class="grid gap-4 sm:grid-cols-2">
					<Field name="name" label="Nom" autocomplete="name" />
					<Field
						name="email"
						label="Email"
						type="email"
						autocomplete="email"
					/>
				</div>
				<Field name="subject" label="Sujet" class="mt-4" />
				<Field name="message" label="Message" rows={5} class="mt-4" />

				{/* anti-spam : champ caché, doit rester vide */}
				<input
					type="text"
					name="_honey"
					tabindex="-1"
					autocomplete="off"
					aria-hidden="true"
					class="hidden"
				/>
				<input type="hidden" name="_captcha" value="false" />
				<input type="hidden" name="_template" value="table" />
				<input
					type="hidden"
					name="_subject"
					value="Nouveau message — portfolio"
				/>

				<button
					type="submit"
					class="mt-6 w-full rounded-full bg-crimson px-6 py-3 text-xs font-bold uppercase tracking-[.2em] text-white transition hover:bg-white hover:text-crimson disabled:cursor-not-allowed disabled:opacity-50"
				>
					Envoyer
				</button>

				<p
					id="form-status"
					class="mt-4 hidden text-sm"
					role="status"
					aria-live="polite"
				>
				</p>
			</form>
		</div>
	</section>
</Layout>

<script>
	const form = document.getElementById(
		"contact-form",
	) as HTMLFormElement | null;
	const status = document.getElementById("form-status");

	function setStatus(msg: string, ok: boolean) {
		if (!status) return;
		status.textContent = msg;
		status.classList.remove("hidden");
		status.style.color = ok ? "#7cfc98" : "#ff6b81";
	}

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		const btn = form.querySelector(
			"button[type=submit]",
		) as HTMLButtonElement;
		const data = new FormData(form);
		if (data.get("_honey")) return; // bot

		btn.disabled = true;
		btn.textContent = "Envoi…";
		try {
			const res = await fetch(form.dataset.endpoint!, {
				method: "POST",
				headers: { Accept: "application/json" },
				body: data,
			});
			const json = await res.json().catch(() => ({}));
			if (res.ok) {
				form.reset();
				setStatus("Message envoyé, merci ! Je te réponds très vite.", true);
			} else {
				setStatus(
					json?.message ||
						"Envoi impossible pour le moment. Réessaie ou écris-moi par email.",
					false,
				);
			}
		} catch {
			setStatus(
				"Erreur réseau. Réessaie ou écris-moi directement par email.",
				false,
			);
		} finally {
			btn.disabled = false;
			btn.textContent = "Envoyer";
		}
	});
</script>
