---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import portrait from "../assets/img/portrait.jpg";
import { breadcrumbNode } from "../lib/seo.js";

const jsonLd = [
	{
		"@type": "AboutPage",
		name: "Profil — Alex Ringenbach",
		mainEntity: { "@id": "https://alex-ringenbach.fr/#person" },
	},
	breadcrumbNode([
		{ name: "Accueil", path: "/" },
		{ name: "Profil", path: "/profil" },
	]),
];

// ⚠️ Contenu a personnaliser : dates, nom du lycee, loisirs, etc.
const parcours = [
	{
		date: "2025 — 2028",
		titre: "BUT Métiers du Multimédia et de l'Internet",
		lieu: "IUT — NFC",
		texte: "Design graphique, typographie, UI/UX, motion et culture visuelle.",
	},
	{
		date: "2024",
		titre: "Baccalauréat Technologique",
		lieu: "Lycée, Belfort",
		texte: "Sciences technologiques de l'industrie et du développement durable (STI2D), spécialité Innovation Technologique et Eco-Conception (ITEC).",
	},
];

const valeurs = [
	{
		t: "La typographie d'abord",
		d: "Une bonne composition typographique règle la moitié d'un projet. Je choisis mes familles, ma grille et mes contrastes avant la couleur.",
	},
	{
		t: "Le système, pas l'image isolée",
		d: "Je conçois des identités qui tiennent sur une affiche comme sur un écran : des règles claires, des composants réutilisables.",
	},
	{
		t: "Le détail qui se voit",
		d: "Alignements, césures, espaces : le soin du détail est ce qui sépare un support correct d'un support juste.",
	},
];

const outils = ["Illustrator", "VsCode", "Figma", "DaVinci Resolve", "Blender"];

const interets = [
	"Affiche & culture print",
	"Photographie",
	"Musique",
	"Manga & animation",
	"Jeux Vidéo",
];
---

<Layout
	title="Profil — Alex Ringenbach"
	description="Parcours, méthode de travail et outils d'Alex Ringenbach, designer graphique en BUT MMI."
	jsonLd={jsonLd}
>
	<!-- Intro -->
	<Section space="intro" waves={4} glow="left" innerClass="items-center gap-y-12">
		<div
			class="col-full relative w-full max-w-xs sm:max-w-sm lg:col-span-4 lg:max-w-none"
		>
			<div class="absolute -bottom-5 -right-5 h-full w-full bg-crimson"></div>
			<Image
				src={portrait}
				alt="Portrait d'Alex Ringenbach"
				width={420}
				densities={[1, 2]}
				format="webp"
				quality={58}
				loading="eager"
				class="relative h-[30rem] w-full object-cover object-top grayscale contrast-125"
			/>
		</div>

		<div class="col-full lg:col-span-7 lg:col-start-6">
			<p class="text-xs font-bold uppercase tracking-[.3em] text-crimson">
				Profil
			</p>
			<h1 class="mt-5 font-display text-5xl leading-[.95] sm:text-6xl">
				Alex Ringenbach
			</h1>
			<p
				class="mt-4 text-sm font-bold uppercase tracking-[.25em] text-white/60"
			>
				Designer graphique · Direction artistique
			</p>

			<div class="mt-8 space-y-4 text-lg leading-relaxed text-white/85">
				<p>
					Je suis étudiant en BUT MMI à Delle, spécialisé en design
					graphique. J'aime le moment où une intention un peu floue
					devient une forme nette : un logo, une grille, une affiche,
					une interface.
				</p>
				<p>
					Mon travail part presque toujours de la typographie et de la
					mise en page. J'essaie de construire des systèmes visuels
					cohérents, qui restent lisibles et vivants d'un support à
					l'autre — du print à l'écran.
				</p>
				<p>
					Je cherche un studio ou une agence où continuer à apprendre,
					sur des projets culturels, éditoriaux ou d'identité de marque.
				</p>
			</div>

			<div class="mt-10 flex flex-wrap gap-3">
				<a
					href="/contact"
					class="rounded-full bg-crimson px-6 py-3 text-xs font-bold uppercase tracking-[.18em] text-white transition hover:bg-white hover:text-crimson"
					>Me contacter</a
				>
				<a
					href="/projets"
					class="rounded-full border border-white/30 px-6 py-3 text-xs font-bold uppercase tracking-[.18em] transition hover:border-crimson hover:text-crimson"
					>Voir mes projets</a
				>
			</div>
		</div>
	</Section>

	<!-- Parcours -->
	<Section tone="light" space="default" waves={false}>
		<div class="col-full lg:col-span-8">
			<p class="text-xs font-bold uppercase tracking-[.3em] text-crimson">
				Parcours
			</p>
			<h2 class="mt-5 font-display text-4xl sm:text-5xl">
				Formation & expériences.
			</h2>

			<ol class="mt-12 space-y-0">
				{
					parcours.map((p) => (
						<li class="grid gap-2 border-t border-ink/15 py-8 sm:grid-cols-[9rem_1fr]">
							<span class="text-sm font-bold uppercase tracking-[.15em] text-crimson">
								{p.date}
							</span>
							<div>
								<h3 class="font-display text-2xl">{p.titre}</h3>
								<p class="mt-1 text-sm font-bold uppercase tracking-widest text-ink/65">
									{p.lieu}
								</p>
								<p class="mt-3 leading-relaxed text-ink/70">
									{p.texte}
								</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</Section>

	<!-- Ce qui m'anime -->
	<Section waves={9} wavesIntensity={0.7}>
		<div class="col-full">
			<p class="text-xs font-bold uppercase tracking-[.3em] text-crimson">
				Ce qui m'anime
			</p>
			<h2 class="mt-5 max-w-xl font-display text-4xl sm:text-5xl">
				Ma façon de travailler.
			</h2>
			<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					valeurs.map((v, i) => (
						<div class="rounded-3xl border border-white/12 bg-white/5 p-6 backdrop-blur-sm">
							<span class="text-xs font-bold text-crimson">
								{String(i + 1).padStart(2, "0")}
							</span>
							<h3 class="mt-6 font-display text-2xl">{v.t}</h3>
							<p class="mt-3 leading-relaxed text-white/70">
								{v.d}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</Section>

	<!-- Outils + hors écran -->
	<Section
		tone="crimson"
		waves={6}
		wavesTone="light"
		wavesIntensity={0.8}
		innerClass="gap-y-12"
	>
		<div class="col-full lg:col-span-6">
			<p class="text-xs font-bold uppercase tracking-[.3em] text-white/70">
				Outils
			</p>
			<h2 class="mt-5 font-display text-4xl sm:text-5xl">
				Ce que j'utilise.
			</h2>
			<ul class="mt-8 flex flex-wrap gap-3">
				{
					outils.map((o) => (
						<li class="rounded-full border border-white/25 bg-ink/40 px-4 py-2 text-sm font-bold uppercase tracking-[.12em]">
							{o}
						</li>
					))
				}
			</ul>
		</div>

		<div class="col-full lg:col-span-6">
			<p class="text-xs font-bold uppercase tracking-[.3em] text-white/70">
				En dehors de l'écran
			</p>
			<h2 class="mt-5 font-display text-4xl sm:text-5xl">
				Là où je pioche.
			</h2>
			<p class="mt-6 leading-relaxed text-white/80">
				Beaucoup de mes idées viennent d'ailleurs que du design :
				affiches et culture print, character design de manga et
				d'animation, direction artistique de jeux vidéo, photo et
				musique.
			</p>
			<ul class="mt-6 flex flex-wrap gap-3">
				{
					interets.map((it) => (
						<li class="rounded-full border border-white/25 px-4 py-2 text-sm">
							{it}
						</li>
					))
				}
			</ul>
		</div>
	</Section>
</Layout>
