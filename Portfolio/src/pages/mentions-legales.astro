---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import BackLink from "../components/BackLink.astro";
import { breadcrumbNode } from "../lib/seo.js";

const jsonLd = [
	breadcrumbNode([
		{ name: "Accueil", path: "/" },
		{ name: "Mentions légales", path: "/mentions-legales" },
	]),
];

// ⚠️ À compléter / vérifier avant mise en ligne :
const infos = {
	editeur: "Alex Ringenbach",
	statut: "Étudiant en BUT MMI — site personnel non professionnel",
	lieu: "Montbéliard, France",
	email: "alex.ringenbach0@gmail.com",
	directeur: "Alex Ringenbach",
	hebergeur: {
		nom: "Infomaniak Network SA",
		adresse: "Rue Eugène-Marziano 25, 1227 Les Acacias (Genève), Suisse",
		contact: "+41 22 820 35 44 — infomaniak.com",
	},
	majDate: "28 août 2026",
};

const sections = [
	{
		titre: "1. Éditeur du site",
		corps: [
			`Le présent site est édité à titre personnel par ${infos.editeur} (${infos.statut}), basé à ${infos.lieu}.`,
			`Contact : ${infos.email}`,
		],
	},
	{
		titre: "2. Directeur de la publication",
		corps: [`${infos.directeur}.`],
	},
	{
		titre: "3. Hébergement",
		corps: [
			`Hébergeur : ${infos.hebergeur.nom}`,
			`Adresse : ${infos.hebergeur.adresse}`,
			`Contact : ${infos.hebergeur.contact}`,
		],
	},
	{
		titre: "4. Nature des projets présentés",
		important: true,
		corps: [
			"La très grande majorité des projets présentés sur ce site ont été réalisés dans un cadre pédagogique (études en BUT MMI) ou en autoformation.",
			"Ils poursuivent un but exclusivement éducatif et non lucratif : ils ne sont ni commercialisés, ni sponsorisés, et n'ont donné lieu à aucune transaction.",
			"La plupart de ces projets ne correspondent pas à des commandes réelles. Les marques, événements, entreprises, personnes ou institutions qui y figurent sont, sauf mention contraire, fictifs ou utilisés uniquement à des fins d'exercice et de démonstration de compétences. Toute ressemblance avec une entité réelle serait fortuite ou relèverait d'un usage pédagogique.",
			"Les noms, logos et marques de tiers éventuellement visibles restent la propriété de leurs détenteurs respectifs et sont montrés à titre illustratif, sans lien commercial.",
		],
	},
	{
		titre: "5. Propriété intellectuelle",
		corps: [
			"Sauf indication contraire, les textes, la mise en page, le code et les créations graphiques de ce site sont l'œuvre d'Alex Ringenbach.",
			"Toute reproduction, représentation ou réutilisation, totale ou partielle, sans autorisation écrite préalable est interdite.",
			"Les visuels de projets réalisés en groupe restent la propriété partagée de leurs auteurs.",
		],
	},
	{
		titre: "6. Données personnelles",
		corps: [
			"Le formulaire de contact collecte les données que vous y saisissez (nom, adresse e-mail, objet et message). Ces informations servent uniquement à traiter votre demande et à y répondre.",
			"L'acheminement des messages est assuré par le service tiers FormSubmit (formsubmit.co), qui agit comme sous-traitant technique. Aucune donnée n'est revendue ni utilisée à des fins commerciales.",
			"Les messages sont conservés le temps nécessaire au traitement de la demande, puis supprimés.",
			`Conformément au RGPD, vous disposez d'un droit d'accès, de rectification et de suppression de vos données : ${infos.email}.`,
		],
	},
	{
		titre: "7. Cookies et mesure d'audience",
		corps: [
			"Ce site ne dépose aucun cookie publicitaire et n'utilise aucun outil de suivi ou de mesure d'audience.",
			"Seules les polices de caractères sont chargées depuis Google Fonts, ce qui implique une requête vers les serveurs de Google (adresse IP).",
		],
	},
	{
		titre: "8. Liens externes",
		corps: [
			"Ce site contient des liens vers des sites tiers (projets en ligne, réseaux sociaux, outils). L'éditeur n'exerce aucun contrôle sur ces ressources et décline toute responsabilité quant à leur contenu.",
		],
	},
	{
		titre: "9. Crédits",
		corps: [
			"Conception et développement : Alex Ringenbach.",
			"Réalisé avec Astro et Tailwind CSS. Police d'affichage : Bevan (Google Fonts). Contenu dynamique servi via PocketBase.",
		],
	},
];
---

<Layout
	title="Mentions légales — Alex Ringenbach"
	description="Mentions légales du portfolio d'Alex Ringenbach : éditeur, hébergement, propriété intellectuelle et données personnelles."
	jsonLd={jsonLd}
>
	<PageIntro eyebrow="Informations" title="Mentions légales" narrow seed={6}>
		<p class="mt-6 text-lg text-white/70">
			Dernière mise à jour : {infos.majDate}.
		</p>
	</PageIntro>

	<section class="bg-white px-6 pb-28 pt-16 text-ink lg:px-[max(8vw,2rem)]">
		<div class="mx-auto max-w-3xl">
			{
				sections.map((s) => (
					<article
						class:list={[
							"mt-12 first:mt-0",
							s.important &&
								"rounded-3xl border border-crimson/30 bg-crimson/5 p-6 sm:p-8",
						]}
					>
						<h2 class="font-display text-2xl sm:text-3xl">
							{s.titre}
						</h2>
						{s.corps.map((p) => (
							<p class="mt-4 leading-relaxed text-ink/75">{p}</p>
						))}
					</article>
				))
			}

			<div class="mt-16"><BackLink /></div>
		</div>
	</section>
</Layout>
