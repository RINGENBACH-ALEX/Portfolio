---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import BackLink from "../components/BackLink.astro";
import Waves from "../components/Waves.astro";
import ProjetCard from "../components/ProjetCard.astro";
import FilterBar from "../components/FilterBar.astro";
import { allProjets } from "../backend.mjs";
import { filtresFrom } from "../lib/group.js";
import { breadcrumbNode, abs } from "../lib/seo.js";

// types PocketBase, dans l'ordre des filtres, avec leur libellé (pluriel)
const TITRES: Record<string, string> = {
	"site-web": "Sites web",
	maquette: "Maquettes",
	"Projet Personnel": "Projets perso",
};

let projets: any[] = [];
try {
	projets = await allProjets();
} catch (e) {
	console.error(
		"Page projets — PocketBase indisponible :",
		(e as Error).message,
	);
}

// une seule grille, du plus récent au plus ancien (tri fait par allProjets)
const filtres = filtresFrom(projets, "type", TITRES);

const jsonLd = [
	breadcrumbNode([
		{ name: "Accueil", path: "/" },
		{ name: "Réalisations", path: "/projets" },
	]),
	{
		"@type": "CollectionPage",
		name: "Réalisations d'Alex Ringenbach",
		mainEntity: {
			"@type": "ItemList",
			itemListElement: projets.map((p, i) => ({
				"@type": "ListItem",
				position: i + 1,
				url: abs(`/projet/${p.id}`),
				name: p.titre,
			})),
		},
	},
];
---

<Layout
	title="Réalisations — Alex Ringenbach"
	description="Projets de design graphique et de développement web réalisés par Alex Ringenbach."
	jsonLd={jsonLd}
>
	<PageIntro eyebrow="Réalisations" title="Du concept à l'expérience." seed={5}>
		<p class="mt-6 max-w-xl text-lg text-white">
			Une sélection de projets menés en formation et en autonomie : sites
			web et maquettes.
		</p>
	</PageIntro>

	<section
		class="relative overflow-clip bg-linear-to-br from-crimson via-[#5c0420] to-ink pb-28 pt-16 text-white"
	>
		<Waves tone="light" intensity={0.8} seed={9} />
		<div class="grid-page relative z-1">
			<div class="col-full">
				{
					projets.length > 0 && (
						<FilterBar
							filtres={filtres}
							label="Filtrer les projets par type"
							statut={["projet affiché", "projets affichés"]}
							vide="Aucun projet dans cette catégorie pour le moment."
						/>
					)
				}

				{/* h2 lu par les lecteurs d'écran : les titres de cartes sont des h3 */}
				<h2 class="sr-only">Liste des projets</h2>
				<ul role="list" class="mt-10 grid gap-6 md:grid-cols-2">
					{
						projets.map((p, i) => (
							<li data-filtre-item={p.type || "Autres"}>
								<ProjetCard projet={p} class="h-full" eager={i < 2} />
							</li>
						))
					}
				</ul>

				{
					projets.length === 0 && (
						<p class="text-white">
							Les projets ne sont pas disponibles pour le moment.
						</p>
					)
				}

				<div class="mt-20">
					<BackLink tone="white" />
				</div>
			</div>
		</div>
	</section>
</Layout>
