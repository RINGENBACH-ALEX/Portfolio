---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import BackLink from "../components/BackLink.astro";
import Waves from "../components/Waves.astro";
import ProjetCard from "../components/ProjetCard.astro";
import { allProjetsByType } from "../backend.mjs";
import { groupBy } from "../lib/group.js";
import { breadcrumbNode, abs } from "../lib/seo.js";

const TITRES: Record<string, string> = {
	"site-web": "Sites web",
	maquette: "Maquettes",
};

let projets: any[] = [];
try {
	projets = await allProjetsByType();
} catch (e) {
	console.error(
		"Page projets — PocketBase indisponible :",
		(e as Error).message,
	);
}

const groupes = groupBy(projets, "type");

const jsonLd = [
	breadcrumbNode([
		{ name: "Accueil", path: "/" },
		{ name: "Réalisations", path: "/projets" },
	]),
	{
		"@type": "CollectionPage",
		name: "Réalisations d'Alex Ringenbach",
		mainEntity: {
			"@type": "ItemList",
			itemListElement: projets.map((p, i) => ({
				"@type": "ListItem",
				position: i + 1,
				url: abs(`/projet/${p.id}`),
				name: p.titre,
			})),
		},
	},
];
---

<Layout
	title="Réalisations — Alex Ringenbach"
	description="Projets de design graphique et de développement web réalisés par Alex Ringenbach."
	jsonLd={jsonLd}
>
	<PageIntro eyebrow="Réalisations" title="Du concept à l'expérience." seed={5}>
		<p class="mt-6 max-w-xl text-lg text-white/70">
			Une sélection de projets menés en formation et en autonomie : sites
			web et maquettes.
		</p>
	</PageIntro>

	<section
		class="relative overflow-hidden bg-linear-to-br from-crimson via-[#5c0420] to-ink pb-28 pt-16 text-white"
	>
		<Waves tone="light" intensity={0.8} seed={9} />
		<div class="grid-page relative z-1">
			<div class="col-full">
				{
					groupes.map((g) => (
						<div class="mt-16 first:mt-0">
							<h2 class="font-display text-3xl sm:text-4xl">
								{TITRES[g.nom] ?? g.nom}
							</h2>
							<div class="mt-8 grid gap-6 md:grid-cols-2">
								{g.items.map((p) => (
									<ProjetCard projet={p} class="h-full" />
								))}
							</div>
						</div>
					))
				}

				{
					projets.length === 0 && (
						<p class="text-white/70">
							Les projets ne sont pas disponibles pour le moment.
						</p>
					)
				}

				<div class="mt-20">
					<BackLink tone="white" />
				</div>
			</div>
		</div>
	</section>
</Layout>
