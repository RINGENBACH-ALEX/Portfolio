---
// Page autonome (sans Header/Footer) : aucun lien de navigation qui
// renverrait de toute façon ici. Activée par src/lib/maintenance.js.
import "../styles/global.css";
import ContactForm from "../components/ContactForm.astro";
import Waves from "../components/Waves.astro";
import { SITE } from "../lib/seo.js";

const title = `Maintenance en cours — ${SITE.shortName}`;
const description = "Le portfolio est en maintenance. Il revient très vite.";
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#02060e" />
		<link
			rel="preload"
			href="/fonts/bevan-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
	</head>

	<body class="bg-ink text-white">
		<main class="relative flex min-h-screen items-center overflow-hidden py-20">
			<!-- même fond que la page Contact : halo rouge + vagues -->
			<div
				class="pointer-events-none absolute -right-40 -top-20 h-144 w-xl rounded-full bg-crimson opacity-25 blur-[130px]"
			>
			</div>
			<Waves tone="accent" intensity={0.7} seed={2} />

			<div class="grid-page relative z-1">
				<div class="col-full flex flex-col items-center text-center">
					<p
						class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-[11px] font-bold uppercase tracking-[.2em] backdrop-blur"
					>
						<span class="pulse h-2 w-2 shrink-0 rounded-full bg-crimson"></span>
						<span>Artboard<span class="hidden sm:inline"> · maintenance</span></span>
					</p>

					<h1
						class="mt-10 font-display leading-[1.05]"
						style="font-size:clamp(2.5rem,8vw,5.5rem)"
					>
						Site en<br /><span class="text-crimson">maintenance</span>
					</h1>

					<p class="mt-8 max-w-md text-base leading-relaxed text-white/85">
						Je retravaille mon portfolio en ce moment. Il revient très vite,
						merci de votre patience&nbsp;!
					</p>

					<div class="mt-8 h-1 w-48 overflow-hidden rounded-full bg-white/15" aria-hidden="true">
						<span class="bar block h-full w-1/3 rounded-full bg-crimson"></span>
					</div>

					<p class="mt-12 text-[11px] font-bold uppercase tracking-[.25em]">
						Une question en attendant&nbsp;?
					</p>
					<p class="mt-3 text-sm text-white/85">
						Écrivez-moi via le formulaire ou à
						<a
							href={`mailto:${SITE.email}`}
							class="underline decoration-crimson underline-offset-4"
							>{SITE.email}</a
						>.
					</p>

					<ContactForm
						class="mt-8 w-full max-w-xl"
						mailSubject="Nouveau message — portfolio (maintenance)"
					/>
				</div>
			</div>
		</main>
	</body>
</html>

<style>
	@media (prefers-reduced-motion: no-preference) {
		.pulse {
			animation: pulse 1.6s ease-in-out infinite;
		}
		.bar {
			animation: slide 1.8s ease-in-out infinite;
		}
		@keyframes pulse {
			50% {
				opacity: 0.3;
			}
		}
		@keyframes slide {
			from {
				transform: translateX(-100%);
			}
			to {
				transform: translateX(300%);
			}
		}
	}
</style>
