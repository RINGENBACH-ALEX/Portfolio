---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import BackLink from "../components/BackLink.astro";
import CompetenceCard from "../components/CompetenceCard.astro";
import { allCompetencesByCategorie } from "../backend.mjs";
import { groupBy } from "../lib/group.js";
import { breadcrumbNode } from "../lib/seo.js";

let competences: any[] = [];
try {
	competences = await allCompetencesByCategorie();
} catch (e) {
	console.error(
		"Page compétences — PocketBase indisponible :",
		(e as Error).message,
	);
}

const groupes = groupBy(competences, "categorie");

const jsonLd = [
	breadcrumbNode([
		{ name: "Accueil", path: "/" },
		{ name: "Compétences", path: "/competences" },
	]),
	{
		"@type": "ItemList",
		name: "Compétences d'Alex Ringenbach",
		itemListElement: competences.map((c, i) => ({
			"@type": "ListItem",
			position: i + 1,
			name: c.nom,
		})),
	},
];
---

<Layout
	title="Compétences — Alex Ringenbach"
	description="Les langages et logiciels maîtrisés par Alex Ringenbach, avec son niveau pour chacun."
	jsonLd={jsonLd}
>
	<PageIntro eyebrow="Compétences" title="Ce que je manie." seed={7}>
		<p class="mt-6 max-w-xl text-lg text-white/70">
			Les langages et les logiciels sur lesquels je m'appuie, avec mon
			niveau de maîtrise pour chacun.
		</p>
	</PageIntro>

	<section class="bg-white px-6 pb-28 pt-16 text-ink lg:px-[max(8vw,2rem)]">
		<div class="mx-auto max-w-6xl">
			{
				groupes.map((g) => (
					<div class="mt-16 first:mt-0">
						<h2 class="font-display text-3xl sm:text-4xl">{g.nom}</h2>
						<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{g.items.map((c) => (
								<CompetenceCard competence={c} />
							))}
						</div>
					</div>
				))
			}

			{
				competences.length === 0 && (
					<p class="text-ink/60">
						Les compétences ne sont pas disponibles pour le moment.
					</p>
				)
			}

			<div class="mt-20"><BackLink /></div>
		</div>
	</section>
</Layout>
