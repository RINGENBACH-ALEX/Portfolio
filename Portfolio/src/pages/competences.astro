---
import Layout from "../layouts/Layout.astro";
import Waves from "../components/Waves.astro";
import CompetenceCard from "../components/CompetenceCard.astro";
import { allCompetencesByCategorie } from "../backend.mjs";

let competences: any[] = [];
try {
	competences = await allCompetencesByCategorie();
} catch (e) {
	console.error(
		"Page compétences — PocketBase indisponible :",
		(e as Error).message,
	);
}

// regroupe par catégorie en gardant l'ordre d'apparition
const groupes: { nom: string; items: any[] }[] = [];
for (const c of competences) {
	const cat = c.categorie || "Autres";
	let g = groupes.find((x) => x.nom === cat);
	if (!g) {
		g = { nom: cat, items: [] };
		groupes.push(g);
	}
	g.items.push(c);
}
---

<Layout>
	<!-- Intro -->
	<section
		class="relative overflow-hidden px-6 pb-20 pt-40 lg:px-[max(8vw,2rem)]"
	>
		<div
			class="pointer-events-none absolute -right-40 -top-24 h-[38rem] w-[38rem] rounded-full bg-crimson opacity-25 blur-[130px]"
		>
		</div>
		<Waves tone="accent" intensity={0.6} seed={7} />

		<div class="relative z-1 mx-auto max-w-6xl">
			<p class="text-xs font-bold uppercase tracking-[.3em] text-crimson">
				Compétences
			</p>
			<h1 class="mt-5 font-display text-5xl leading-[.95] sm:text-6xl">
				Ce que je manie.
			</h1>
			<p class="mt-6 max-w-xl text-lg text-white/70">
				Les langages et les logiciels sur lesquels je m'appuie, avec mon
				niveau de maîtrise pour chacun.
			</p>
		</div>
	</section>

	<!-- Grille -->
	<section class="bg-white px-6 pb-28 pt-16 text-ink lg:px-[max(8vw,2rem)]">
		<div class="mx-auto max-w-6xl">
			{
				groupes.map((g) => (
					<div class="mt-16 first:mt-0">
						<h2 class="font-display text-3xl sm:text-4xl">{g.nom}</h2>
						<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{g.items.map((c) => (
								<CompetenceCard competence={c} />
							))}
						</div>
					</div>
				))
			}

			{
				competences.length === 0 && (
					<p class="text-ink/60">
						Les compétences ne sont pas disponibles pour le moment.
					</p>
				)
			}

			<div class="mt-20">
				<a
					href="/"
					class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[.18em] text-crimson transition hover:text-ink"
				>
					<svg
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg
					>
					Retour à l'accueil
				</a>
			</div>
		</div>
	</section>
</Layout>
