---
import sharp from "sharp";
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Waves from "../../components/Waves.astro";
import BackLink from "../../components/BackLink.astro";
import Icon from "../../components/Icon.astro";
import { allProjets, getFileUrl } from "../../backend.mjs";
import { hostname } from "../../lib/url.js";
import { breadcrumbNode, abs, excerpt } from "../../lib/seo.js";

export async function getStaticPaths() {
	let projets: any[] = [];
	try {
		projets = await allProjets();
	} catch (e) {
		console.error(
			"projet/[id] — PocketBase indisponible :",
			(e as Error).message,
		);
	}
	return projets.map((p) => ({ params: { id: p.id }, props: { projet: p } }));
}

const TYPES: Record<string, string> = {
	"site-web": "Site web",
	maquette: "Maquette",
};

const { projet: p } = Astro.props;
const typeLabel = p.type ? (TYPES[p.type] ?? p.type) : "";
const host = hostname(p.lien);

const fichiers: string[] = Array.isArray(p.image)
	? p.image
	: p.image
		? [p.image]
		: [];

// dimensions réelles (pour redimensionner sans déformer) — 1 seul fetch au build
const MAX_W = 900;
const images = (
	await Promise.all(
		fichiers.map(async (f) => {
			const url = getFileUrl(p, f);
			if (!url) return null;
			try {
				const buf = Buffer.from(await (await fetch(url)).arrayBuffer());
				const m = await sharp(buf).metadata();
				const w = Math.min(m.width ?? MAX_W, MAX_W);
				const h = Math.round((w * (m.height ?? 1)) / (m.width ?? 1));
				return { url, w, h };
			} catch {
				return { url, w: MAX_W, h: Math.round(MAX_W * 0.66) };
			}
		}),
	)
).filter((x): x is { url: string; w: number; h: number } => x !== null);

// version optimisée (locale) de la 1re image -> partage social
const ogImg = images[0]
	? await getImage({
			src: images[0].url,
			width: 1200,
			height: 630,
			format: "webp",
		})
	: null;

const jsonLd = [
	breadcrumbNode([
		{ name: "Accueil", path: "/" },
		{ name: "Réalisations", path: "/projets" },
		{ name: p.titre, path: `/projet/${p.id}` },
	]),
	{
		"@type": "CreativeWork",
		name: p.titre,
		description: p.description,
		url: abs(`/projet/${p.id}`),
		...(p.lien ? { sameAs: p.lien } : {}),
		...(ogImg ? { image: abs(ogImg.src) } : {}),
		genre: typeLabel || undefined,
		author: { "@id": "https://alex-ringenbach.fr/#person" },
		creator: { "@id": "https://alex-ringenbach.fr/#person" },
		inLanguage: "fr-FR",
	},
];
---

<Layout
	title={`${p.titre} — ${typeLabel || "Projet"} par Alex Ringenbach`}
	description={excerpt(p.description)}
	type="article"
	image={ogImg?.src}
	jsonLd={jsonLd}
>
	<section class="relative overflow-hidden pb-20 pt-40">
		<div
			class="pointer-events-none absolute -right-40 -top-24 h-[38rem] w-[38rem] rounded-full bg-crimson opacity-25 blur-[130px]"
		>
		</div>
		<Waves tone="accent" intensity={0.6} seed={3} />

		<div class="grid-page relative z-1">
			<div class="col-full lg:col-span-9">
				<BackLink href="/projets" label="Réalisations" tone="muted" />

				{
					typeLabel && (
						<p class="mt-8 text-xs font-bold uppercase tracking-[.3em] text-crimson">
							{typeLabel}
						</p>
					)
				}
				<h1 class="mt-4 font-display text-4xl leading-[.95] sm:text-6xl">
					{p.titre}
				</h1>
				<p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80">
					{p.description}
				</p>

				{
					p.lien && (
						<a
							href={p.lien}
							target="_blank"
							rel="noreferrer"
							class="mt-8 inline-flex max-w-full items-center gap-2 rounded-full bg-crimson px-6 py-3 text-xs font-bold uppercase tracking-[.18em] text-white transition hover:bg-white hover:text-crimson"
						>
							<span class="shrink-0">Ouvrir le projet</span>
							<Icon name="external" size={15} class="shrink-0" />
							{host && (
								<span class="truncate font-normal normal-case tracking-normal opacity-90">
									{host}
								</span>
							)}
						</a>
					)
				}
			</div>
		</div>
	</section>

	{
		images.length > 0 && (
			<section class="bg-white pb-28 pt-16">
				<div class="grid-page">
					<div class="col-full">
						<p class="text-xs font-bold uppercase tracking-[.3em] text-crimson">
							Aperçu
						</p>
						<div class="mt-8 grid grid-cols-2 items-start gap-6 lg:grid-cols-3">
							{images.map((im, i) => (
								<a
									href={im.url}
									target="_blank"
									rel="noreferrer"
									class="block overflow-hidden rounded-2xl border border-ink/10 transition hover:border-crimson"
								>
									<Image
										src={im.url}
										alt={`${p.titre} — aperçu ${i + 1}`}
										width={im.w}
										height={im.h}
										format="webp"
										quality={68}
										class="w-full"
										loading="lazy"
									/>
								</a>
							))}
						</div>
					</div>
				</div>
			</section>
		)
	}
</Layout>
