---
import sharp from "sharp";
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Waves from "../../components/Waves.astro";
import BackLink from "../../components/BackLink.astro";
import Icon from "../../components/Icon.astro";
import {
	allProjets,
	getFileUrl,
	getImageUrl,
	competencesOfProjet,
	processusOfProjet,
} from "../../backend.mjs";
import { breadcrumbNode, abs, excerpt } from "../../lib/seo.js";

export async function getStaticPaths() {
	let projets: any[] = [];
	try {
		projets = await allProjets();
	} catch (e) {
		console.error(
			"projet/[id] — PocketBase indisponible :",
			(e as Error).message,
		);
	}
	return projets.map((p) => ({ params: { id: p.id }, props: { projet: p } }));
}

const TYPES: Record<string, string> = {
	"site-web": "Site web",
	maquette: "Maquette",
	"Projet Personnel": "Projet perso",
};

const { projet: p } = Astro.props;
const typeLabel = p.type ? (TYPES[p.type] ?? p.type) : "";
const host = p.lien ? new URL(p.lien).hostname.replace(/^www\./, "") : "";
const competences = competencesOfProjet(p);
const processus = processusOfProjet(p);

const fichiers: string[] = Array.isArray(p.image)
	? p.image
	: p.image
		? [p.image]
		: [];

// dimensions réelles (pour redimensionner sans déformer) — 1 seul fetch au build
const MAX_W = 1200;
const images = (
	await Promise.all(
		fichiers.map(async (f) => {
			const url = getFileUrl(p, f);
			if (!url) return null;
			try {
				const buf = Buffer.from(await (await fetch(url)).arrayBuffer());
				const m = await sharp(buf).metadata();
				const w = Math.min(m.width ?? MAX_W, MAX_W);
				const h = Math.round((w * (m.height ?? 1)) / (m.width ?? 1));
				return { url, w, h };
			} catch {
				return { url, w: MAX_W, h: Math.round(MAX_W * 0.66) };
			}
		}),
	)
).filter((x): x is { url: string; w: number; h: number } => x !== null);

// Versions webp générées au build : ce sont elles qu'on affiche ET qu'on ouvre
// au clic. Avant, les liens pointaient vers l'URL brute PocketBase
// (http://127.0.0.1:8090/…) -> liens morts une fois le site en ligne.
const optimises = await Promise.all(
	images.map(async (im, i) => {
		const out = await getImage({
			src: im.url,
			width: im.w,
			height: im.h,
			format: "webp",
			quality: i === 0 ? 70 : 68,
		});
		return { src: out.src, w: im.w, h: im.h };
	}),
);

const cover = optimises[0] ?? null;
const gallery = optimises.slice(1);

// version optimisée (locale) de la 1re image -> partage social
const ogImg = images[0]
	? await getImage({
			src: images[0].url,
			width: 1200,
			height: 630,
			format: "webp",
		})
	: null;

// méta affichées sous le titre
const meta = [typeLabel && { k: "Type", v: typeLabel }].filter(
	Boolean,
) as { k: string; v: string }[];

const jsonLd = [
	breadcrumbNode([
		{ name: "Accueil", path: "/" },
		{ name: "Réalisations", path: "/projets" },
		{ name: p.titre, path: `/projet/${p.id}` },
	]),
	{
		"@type": "CreativeWork",
		name: p.titre,
		description: p.description,
		url: abs(`/projet/${p.id}`),
		...(p.lien ? { sameAs: p.lien } : {}),
		...(ogImg ? { image: abs(ogImg.src) } : {}),
		...(competences.length
			? { keywords: competences.map((c: any) => c.nom).join(", ") }
			: {}),
		genre: typeLabel || undefined,
		author: { "@id": "https://alex-ringenbach.fr/#person" },
		creator: { "@id": "https://alex-ringenbach.fr/#person" },
		inLanguage: "fr-FR",
	},
];
---

<Layout
	title={`${p.titre} — ${typeLabel || "Projet"} par Alex Ringenbach`}
	description={excerpt(p.description)}
	type="article"
	image={ogImg?.src}
	jsonLd={jsonLd}
>
	<!-- Intro -->
	<section class="relative overflow-hidden pb-16 pt-40">
		<div
			class="pointer-events-none absolute -right-40 -top-24 h-[38rem] w-[38rem] rounded-full bg-crimson opacity-25 blur-[130px]"
		>
		</div>
		<Waves tone="accent" intensity={0.6} seed={3} />

		<div class="grid-page relative z-1">
			<div class="col-full lg:col-span-9">
				<BackLink href="/projets" label="Réalisations" tone="muted" />

				{
					typeLabel && (
						<p class="mt-8 text-xs font-bold uppercase tracking-[.3em] text-white">
							{typeLabel}
						</p>
					)
				}
				<h1 class="mt-4 font-display text-4xl leading-[.95] sm:text-6xl">
					{p.titre}
				</h1>
				<p class="mt-6 max-w-2xl text-lg leading-relaxed text-white">
					{p.description}
				</p>

				{
					p.lien && (
						<a
							href={p.lien}
							target="_blank"
							rel="noreferrer"
							class="mt-8 inline-flex max-w-full items-center gap-2 rounded-full bg-crimson px-6 py-3 text-xs font-bold uppercase tracking-[.18em] text-white transition hover:bg-white hover:text-crimson"
						>
							<span class="shrink-0">Ouvrir le projet</span>
							<Icon name="external" size={15} class="shrink-0" />
							{host && (
								<span class="truncate font-normal normal-case tracking-normal opacity-90">
									{host}
								</span>
							)}
							<span class="sr-only">(nouvel onglet)</span>
						</a>
					)
				}
			</div>

			{
				meta.length > 0 && (
					<dl class="col-full mt-14 grid grid-cols-2 gap-6 border-t border-white/12 pt-8 sm:grid-cols-4">
						{meta.map((m) => (
							<div>
								<dt class="text-[11px] font-bold uppercase tracking-[.22em] text-white">
									{m.k}
								</dt>
								<dd class="mt-2 text-sm text-white">{m.v}</dd>
							</div>
						))}
					</dl>
				)
			}
		</div>
	</section>

	<!-- Détail éditorial -->
	<section class="bg-white pb-28 pt-20 text-ink">
		<div class="grid-page gap-x-6 gap-y-16">
			{
				(p.description || competences.length > 0) && (
					<div class="col-full lg:col-span-6">
						{p.description && (
							<>
								<h2 class="font-display text-3xl sm:text-4xl">Contexte</h2>
								<p class="mt-6 leading-relaxed text-ink/75">
									{p.description}
								</p>
							</>
						)}

						{competences.length > 0 && (
							<div class:list={[p.description && "mt-12"]}>
								<h2 class="font-display text-2xl sm:text-3xl">
									Compétences utilisées
								</h2>
								<ul class="mt-6 flex flex-wrap gap-3">
									{competences.map((c: any) => {
										const logo = getImageUrl(c, "Logo");
										return (
											<li class="flex max-w-full items-center gap-3 rounded-full border border-ink/15 py-2 pl-2 pr-5 transition hover:border-crimson">
												{logo && (
													<Image
														src={logo}
														alt=""
														width={80}
														height={80}
														format="webp"
														quality={80}
														class="h-10 w-10 shrink-0 rounded-xl bg-ink/3 object-contain p-1.5"
														loading="lazy"
													/>
												)}
												<span class="truncate text-sm font-bold">
													{c.nom}
												</span>
											</li>
										);
									})}
								</ul>
							</div>
						)}
					</div>
				)
			}

			{
				cover && (
					<a
						href={cover.src}
						target="_blank"
						rel="noreferrer"
						class="col-full flex items-start justify-center overflow-hidden rounded-3xl border border-ink/10 bg-ink/2 p-3 transition hover:border-crimson sm:p-5 lg:col-span-5 lg:col-start-8"
					>
						<img
							src={cover.src}
							alt={`${p.titre} — visuel principal`}
							width={cover.w}
							height={cover.h}
							class="max-h-128 w-auto max-w-full rounded-xl object-contain"
							loading="eager"
							decoding="async"
						/>
						<span class="sr-only">(agrandir dans un nouvel onglet)</span>
					</a>
				)
			}

			{
				processus.length > 0 && (
					<div class="col-full lg:col-span-10">
						<h2 class="font-display text-3xl sm:text-4xl">Processus</h2>
						<ol class="mt-10 grid gap-6 md:grid-cols-2">
							{processus.map((step: { titre: string; html: string }, i: number) => (
								<li class="rounded-3xl border border-ink/10 bg-ink/2 p-6">
									<span class="font-display text-2xl text-crimson">
										{String(i + 1).padStart(2, "0")}
									</span>
									<h3 class="mt-3 font-display text-xl">
										{step.titre}
									</h3>
									<div
										class="processus-texte mt-2 leading-relaxed text-ink/70"
										set:html={step.html}
									/>
								</li>
							))}
						</ol>
					</div>
				)
			}

			{
				gallery.length > 0 && (
					<div class="col-full">
						<h2 class="font-display text-3xl sm:text-4xl">Aperçu</h2>
						<div class="mt-8 grid grid-cols-2 gap-6 lg:grid-cols-3">
							{gallery.map((im, i) => (
								<a
									href={im.src}
									target="_blank"
									rel="noreferrer"
									class="flex h-64 items-center justify-center overflow-hidden rounded-2xl border border-ink/10 bg-ink/2 p-2 transition hover:border-crimson sm:h-80"
								>
									<img
										src={im.src}
										alt={`${p.titre} — aperçu ${i + 2}`}
										width={im.w}
										height={im.h}
										class="max-h-full w-auto max-w-full object-contain"
										loading="lazy"
										decoding="async"
									/>
									<span class="sr-only">(agrandir dans un nouvel onglet)</span>
								</a>
							))}
						</div>
					</div>
				)
			}

			<div class="col-full">
				<BackLink href="/projets" label="Toutes les réalisations" />
			</div>
		</div>
	</section>
</Layout>

<style>
	/* contenu HTML de l'éditeur PocketBase : espace entre les paragraphes */
	.processus-texte :global(p + p) {
		margin-top: 0.75rem;
	}
	.processus-texte :global(strong) {
		color: var(--color-ink);
	}
</style>
