---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, abs, websiteNode, personNode } from "../lib/seo.js";

interface Props {
	title?: string;
	description?: string;
	/** type Open Graph : "website" (défaut) ou "article" */
	type?: "website" | "article";
	/** image de partage (chemin relatif) */
	image?: string;
	/** nœuds JSON-LD spécifiques à la page */
	jsonLd?: Record<string, unknown>[];
	noindex?: boolean;
}

const {
	title = SITE.name,
	description = SITE.description,
	type = "website",
	image = SITE.ogImage,
	jsonLd = [],
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = abs(image);

const graph = {
	"@context": "https://schema.org",
	"@graph": [websiteNode(), personNode(), ...jsonLd],
};
// échappe "<" pour ne jamais casser la balise <script>
const graphJson = JSON.stringify(graph).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE.author} />
		<meta
			name="robots"
			content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"}
		/>
		<link rel="canonical" href={canonical} />

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE.shortName} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${SITE.author} — ${SITE.jobTitle}`} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Icônes -->
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#02060e" />

		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="preload"
			href="/fonts/bevan-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<script
			is:inline
			type="application/ld+json"
			set:html={graphJson}
		/>
	</head>

	<body>
		<a href="#contenu" class="skip-link">Aller au contenu</a>
		<Header />
		<main id="contenu" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.skip-link {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 50;
		margin: 0.75rem;
		border-radius: 9999px;
		background: var(--color-crimson);
		padding: 0.75rem 1.25rem;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: #fff;
		transform: translateY(-150%);
		transition: transform 0.2s;
	}
	.skip-link:focus {
		transform: translateY(0);
	}
</style>
